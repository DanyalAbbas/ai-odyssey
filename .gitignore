# Raw datasets and derived caches: reproduced from the public sources in
# REPORT.md §3.1, not redistributed here.
data/
contacts/

# Vendored weights ship as a separate zip (435 MB); fetching them into git would
# bloat the repo without adding anything the checksums in §12.4 do not already pin.
submit/models/
submit/*.zip
submit/predicted*.csv

# Demo UI: gallery cache and identities enrolled during a demo
app/.cache/
app/demo_gallery/

# Python
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
*.swp

# Weights (checksums in REPORT.md §12.4); the submission carries its own copies
models/
submit.zip

# Playwright MCP working files
.playwright-mcp/

# Experiment logs (scratch output; results/ carries the numbers)
experiments/logs/*.log
